# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
mono_crash.*.json

# Build/export output
export/
builds/

# OS-specific
.DS_Store
Thumbs.db

# Runtime/local-only files
scripts/.flickbattle_pids.txt
scripts/.flickbattle_solo_pid.txt
scripts/.test_run_solo.log
.claude/scheduled_tasks.lock

# Art scratch folder — full-res source exports, not shipped (has a .gdignore
# so Godot skips it too). Downscaled copies live in assets/achievements/.
assets/Raw Work folder/

# Account-data backups (contain real player data) — never committed.
deploy/backups/
